    static void triangulos()
    {
        Scanner scanner = new Scanner(System.in);
        String opc = "s";

        while(opc.equals("s"))
        {
            System.out.println("Este programa sirve para saber si se puede formar un triangulo y su tipo");
            System.out.print("Ingresa la longitud del primer lado: ");
            double l1 = scanner.nextDouble();
            System.out.print("Ingresa la longitud del segundo lado: ");
            double l2 = scanner.nextDouble();
            System.out.print("Ingresa la longitud del tercer lado: ");
            double l3 = scanner.nextDouble();

            if (l1 <= 0 || l2 <= 0 || l3 <= 0) {
                System.out.println("Las longitudes deben ser numeros positivos.");
            } else {
                if (l1 + l2 >= l3 && l1 + l3 >= l2 && l2 + l3 >= l1) {
                    if (l1 == l2 && l2 == l3) {
                        System.out.println("El triángulo es equilatero.");
                    } else if (l1 == l2 || l1 == l3 || l2 == l3) {
                        System.out.println("El triangulo es isosceles.");
                    } else {
                        System.out.println("El triangulo es escaleno.");
                    }
                } else {
                    System.out.println("Las longitudes proporcionadas no forman un triangulo valido.");
                }
            }  
        
            System.out.println("Otra vez s/n: ");
            opc = scanner.next();
        }
        //scanner.close();
    }

    static void padovan(){
