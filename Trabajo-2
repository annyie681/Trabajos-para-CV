            int p1 = 1, p2 = 1, p3 = 1, pn;
        
            for (; p1 <= limite;) {
            System.out.print(p1 + "");
                pn = p1 + p2;
                p1 = p2;
                p2 = p3;
                p3 = pn;
                if (p1 <= limite) {
